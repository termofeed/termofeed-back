# Porta do servidor HTTP
PORT=8080

# URL publica base do frontend (para geracao do joinUrl nos links de salas)
PUBLIC_BASE_URL=http://localhost:5173

# Origens permitidas para CORS e WebSocket (separadas por virgula)
ALLOWED_ORIGINS=http://localhost:5173

# Limite padrao de participantes por sala
MAX_PARTICIPANTS=200

# Tempo de retencao em horas apos encerramento da sala antes de responder 410 Gone
RETENTION_HOURS=24

# Nivel de log (debug, info, warn, error)
LOG_LEVEL=info

# Habilitar confianca no proxy reverso para IP real (X-Forwarded-For)
TRUSTED_PROXY=false
